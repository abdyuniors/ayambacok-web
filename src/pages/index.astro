---
import Layout from '../layouts/Layout.astro';

// Data Produk disesuaikan untuk ayam hidup/pedaging
const products = [
  {
    name: "Ayam Pedaging Ukuran Kecil",
    desc: "Berat hidup ± 1.0 kg - 1.2 kg. Cocok untuk konsumsi harian.",
    price: "Mulai Rp 50.000 /ekor",
    waText: "Halo AyamBacok, saya mau beli ayam pedaging ukuran kecil. Apakah stoknya ada?",
    image: "https://placehold.co/600x400/fef3c7/b45309?text=Foto+Ayam+Kecil"
  },
  {
    name: "Ayam Pedaging Ukuran Sedang",
    desc: "Berat hidup ± 1.3 kg - 1.6 kg. Pas untuk acara keluarga atau syukuran.",
    price: "Mulai Rp 60.000 /ekor",
    waText: "Halo AyamBacok, saya mau beli ayam pedaging ukuran sedang.",
    image: "https://placehold.co/600x400/fef3c7/b45309?text=Foto+Ayam+Sedang"
  },
  {
    name: "Ayam Pedaging Ukuran Besar",
    desc: "Berat hidup di atas 1.7 kg. Daging tebal, puas untuk makan besar.",
    price: "Mulai Rp 75.000 /ekor",
    waText: "Halo AyamBacok, saya mau pesan ayam pedaging ukuran besar.",
    image: "https://placehold.co/600x400/fef3c7/b45309?text=Foto+Ayam+Besar"
  }
];
---

<Layout title="AyamBacok | Jual Ayam Pedaging Hidup">
	<!-- Navbar Sederhana -->
	<header class="bg-white shadow-sm sticky top-0 z-40">
		<div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
			<h1 class="text-2xl font-black text-red-600 tracking-tighter">AYAM<span class="text-gray-800">BACOK</span></h1>
			<a href="#produk" class="text-gray-600 hover:text-red-600 font-semibold transition">Lihat Stok</a>
		</div>
	</header>

	<!-- Hero Section -->
	<section class="bg-amber-50 py-20 px-4 text-center">
		<div class="max-w-3xl mx-auto">
			<span class="bg-amber-200 text-amber-800 px-3 py-1 rounded-full text-sm font-bold tracking-wide">USAHA RUMAHAN LOKAL</span>
			<h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mt-6 leading-tight">
				Ayam Pedaging Sehat, <br/> Langsung Pilih di Tempat!
			</h2>
			<p class="mt-6 text-lg text-gray-600 mb-8">
				Kami menyediakan ayam pedaging (broiler) hidup berkualitas. Ayam dijamin sehat, lincah, dan timbangan jujur. Melayani pembelian eceran untuk kebutuhan dapur Anda.
			</p>
			<div class="flex flex-col sm:flex-row justify-center gap-4">
                <a 
                    href="#produk" 
                    class="bg-red-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg hover:bg-red-700 transition transform hover:-translate-y-1"
                >
                    Lihat Pilihan Ayam
                </a>
                <a 
                    href="https://wa.me/6281234567890?text=Halo%20AyamBacok,%20saya%20mau%20tanya%20harga%20ayam%20hari%20ini." 
                    target="_blank"
                    class="bg-white text-gray-800 border-2 border-gray-200 font-bold py-3 px-8 rounded-lg shadow-sm hover:border-gray-300 transition"
                >
                    Tanya Harga Hari Ini
                </a>
            </div>
		</div>
	</section>

	<!-- Fitur / Keunggulan (Fokus Usaha Rumahan) -->
	<section class="py-16 bg-white px-4">
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
			<div class="p-6 border rounded-xl shadow-sm hover:shadow-md transition">
				<div class="w-16 h-16 mx-auto bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-2xl font-black mb-4">⚖️</div>
				<h3 class="text-xl font-bold mb-2">Timbangan Jujur</h3>
				<p class="text-gray-600">Ayam ditimbang langsung di depan Anda. Kami menjamin berat yang transparan sesuai harga.</p>
			</div>
			<div class="p-6 border rounded-xl shadow-sm hover:shadow-md transition">
				<div class="w-16 h-16 mx-auto bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-2xl font-black mb-4">🐔</div>
				<h3 class="text-xl font-bold mb-2">Ayam Sehat & Lincah</h3>
				<p class="text-gray-600">Kesehatan ayam adalah prioritas kami. Ayam dirawat dengan baik sebelum sampai ke tangan Anda.</p>
			</div>
            
			<!-- Bagian ini yang kita ubah: Bisa Bantu Antar -->
			<div class="p-6 border rounded-xl shadow-sm hover:shadow-md transition">
				<div class="w-16 h-16 mx-auto bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-2xl font-black mb-4">🛵</div>
				<h3 class="text-xl font-bold mb-2">Bisa Bantu Antar</h3>
				<p class="text-gray-600">Kami siap mengantar pesanan langsung ke rumah Anda dengan ongkir yang dijamin murah dan bersahabat.</p>
			</div>
		</div>
	</section>

	<!-- Katalog Produk -->
	<section id="produk" class="py-20 bg-gray-50 px-4">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-extrabold text-gray-900">Pilihan Ayam Pedaging Kami</h2>
				<p class="text-gray-600 mt-2">Harga dapat berubah sewaktu-waktu mengikuti harga pasar. Silakan WhatsApp untuk kepastian stok.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{products.map((item) => (
					<div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100 hover:shadow-xl transition-all">
						
                        <!-- Elemen Gambar Thumbnail -->
						<img 
                            src={item.image} 
                            alt={item.name} 
                            class="w-full h-48 object-cover bg-amber-50" 
                        />
                        
						<div class="p-6">
							<h3 class="text-xl font-bold text-gray-900 mb-1">{item.name}</h3>
							<p class="text-gray-500 text-sm mb-4 h-10">{item.desc}</p>
							<div class="text-red-600 font-bold text-lg mb-6">{item.price}</div>
							
							<a 
								href={`https://wa.me/6281234567890?text=${encodeURIComponent(item.waText)}`}
								target="_blank"
								class="block w-full text-center bg-green-500 text-white font-semibold py-2 rounded hover:bg-green-600 transition"
							>
								Pesan via WhatsApp
							</a>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Testimoni / Kata Pelanggan -->
	<section class="py-16 bg-amber-50 px-4 border-t border-amber-100">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-extrabold text-gray-900">Apa Kata Pelanggan Kami?</h2>
				<p class="text-gray-600 mt-2">Kepuasan tetangga dan pelanggan di lingkungan sekitar adalah kebanggaan kami.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Ulasan 1 -->
				<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
					<div class="text-amber-400 text-xl mb-3">★★★★★</div>
					<p class="text-gray-700 italic mb-4">"Ayamnya lincah dan sehat-sehat. Kemarin beli 3 ekor minta diantar ke rumah cepat banget, ongkirnya juga murah. Timbangannya pas!"</p>
					<div class="font-bold text-gray-900">- Ibu Dita, Warga Komplek</div>
				</div>

				<!-- Ulasan 2 -->
				<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
					<div class="text-amber-400 text-xl mb-3">★★★★★</div>
					<p class="text-gray-700 italic mb-4">"Sangat terbantu buat warung makan saya. Harganya jujur sesuai timbangan di depan mata, nggak dinaik-naikin. Penjualnya juga ramah."</p>
					<div class="font-bold text-gray-900">- Pak Muh, Pemilik Warung</div>
				</div>

				<!-- Ulasan 3 -->
				<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
					<div class="text-amber-400 text-xl mb-3">★★★★★</div>
					<p class="text-gray-700 italic mb-4">"Enak beli di sini, ayamnya berkualitas. Buat yang nggak mau repot keluar, layanan antarnya sangat bisa diandalkan. Sukses terus AyamBacok!"</p>
					<div class="font-bold text-gray-900">- Mas Adit, Pelanggan Setia</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer / Info Operasional & Lokasi -->
	<footer class="bg-gray-900 text-white py-12 px-4">
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
			<div>
				<h2 class="text-2xl font-black text-white tracking-tighter mb-4">AYAM<span class="text-red-500">BACOK</span></h2>
				<p class="text-gray-400 text-sm max-w-sm">
					Usaha rumahan penyedia ayam pedaging (broiler) hidup berkualitas. Kami mengutamakan kejujuran dan kepuasan pelanggan di lingkungan sekitar.
				</p>
			</div>
			<div>
				<h4 class="text-lg font-bold mb-4">Kunjungi Kami</h4>
				<ul class="text-gray-400 space-y-4 text-sm">
					<li class="flex items-start">
                        <span class="mr-3 text-xl">📍</span> 
                        <div>
                            <strong class="text-white text-base">Alamat Kandang:</strong><br/>
                            <span class="inline-block mt-1 mb-3">Jl. Adhyaksa, Kel. Mokdale, Kec. Lobalain, Kota Ba'a.<br/><span class="text-xs text-gray-500">(Patokan: Depan Kantor Dinas Sosial Rote)</span></span>
                            
                            <!-- Tombol Google Maps -->
                            <div>
                                <a 
                                    href="https://maps.app.goo.gl/Pe9fSQpw83gZGm8Y8" 
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                                    </svg>
                                    Buka Titik di Google Maps
                                </a>
                            </div>
                        </div>
                    </li>
					<li class="flex items-start pt-2">
                        <span class="mr-3 text-xl">🕒</span>
                        <span><strong class="text-white text-base">Buka:</strong><br/>Setiap Hari, Pukul 06.00 - 20.00 WITA</span>
                    </li>
				</ul>
			</div>
		</div>
		<div class="max-w-6xl mx-auto mt-12 pt-8 border-t border-gray-800 text-center text-gray-500 text-sm">
			&copy; 2026 AyamBacok. All rights reserved.
		</div>
	</footer>
</Layout>